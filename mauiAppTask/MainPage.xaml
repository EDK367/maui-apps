<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mauiAppTask.MainPage"
             xmlns:vm="clr-namespace:mauiAppTask.viewModels"
             >

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

    <Frame Grid.Row="0" BackgroundColor="#ee3939ff"
        CornerRadius="0" Padding="0" Margin="-20,-20,-20,0">

        <Label Text="Tareas" TextColor="White"
            FontSize="20" FontAttributes="Bold"
            HorizontalOptions="Center" Padding="15" />
    </Frame>

    <CollectionView Grid.Row="1" ItemsSource="{Binding Tareas}"
            Margin="0,20,0,0">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="*, Auto" Padding="10,8">
                    <Label Grid.Column="0" Text="{Binding Nombre}"
                        FontSize="18"
                        VerticalOptions="Center"
                        TextColor="White"/>
                    <CheckBox Grid.Column="1"
                        IsChecked="{Binding Realizada}"
                        Color="#20f54eff"/>

                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
        
    <Button 
        Grid.Row="2" Text="Agregar Tarea"
        BackgroundColor="#FE5623" TextColor="White"
        FontAttributes="Bold" 
        Margin="0,20,0,0"
        CornerRadius="25"
        Padding="30,15"
        Command="{Binding GoCreateTaskCommand}"
        HorizontalOptions="End"
        VerticalOptions="End"
        />
    </Grid>
        

</ContentPage>
