<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:mauiAppTask.viewModels"
             x:Class="mauiAppTask.Views.AddTaskPage"
             Title="Nueva Tarea">

    <ContentPage.BindingContext>
        <vm:AddTaskViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Nueva Tarea" FontSize="24" FontAttributes="Bold" />
        
        <Entry Placeholder="Escribe la tarea..." 
               Text="{Binding NewTask}" />
        
        <Entry Placeholder="Escribe la descripción..." 
               Text="{Binding NewDescription}" />
        
        <Button Text="Guardar" 
                BackgroundColor="#22c220ff" TextColor="White"
                Command="{Binding CreateTaskCommand}" />
        
        <Button Text="Cancelar" 
                BackgroundColor="Gray" TextColor="White"
                Command="{Binding CancelCommand}" />
    </VerticalStackLayout>
</ContentPage>