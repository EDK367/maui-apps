<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="parcial2Progra.Views.AsignacionesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:parcial2Progra.ViewModels"
    xmlns:models="clr-namespace:parcial2Progra.Models"
    x:DataType="vm:AsignacionesViewModel"
    Title="Asignaciones">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Registrar Asignación" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />

            <Frame BorderColor="#E0E0E0"  BackgroundColor="#419d04ff" CornerRadius="12" Padding="16" HasShadow="True">
                <VerticalStackLayout Spacing="8">

                    <Label Text="Alumno *" FontAttributes="Bold" />
                    <Picker Title="Selecciona un alumno"
                            ItemsSource="{Binding Alumnos}"
                            SelectedItem="{Binding AlumnoSeleccionado}"
                            ItemDisplayBinding="{Binding Nombre}" />

                    <Label Text="Curso *" FontAttributes="Bold" />
                    <Picker Title="Selecciona un curso"
                            ItemsSource="{Binding Cursos}"
                            SelectedItem="{Binding CursoSeleccionado}"
                            ItemDisplayBinding="{Binding Nombre}" />

                    <Label Text="Comentarios" FontAttributes="Bold" />
                    <Editor Text="{Binding Comentarios}"
                            Placeholder="Comentarios opcionales..."
                            HeightRequest="70"
                            AutoSize="TextChanges" />

                    <Button Text="Guardar Asignación"
                            Command="{Binding GuardarCommand}"
                            BackgroundColor="#6C63FF"
                            TextColor="White"
                            CornerRadius="10"
                            Margin="0,8,0,0" />

                    <Label Text="{Binding Mensaje}" HorizontalOptions="Center" FontAttributes="Italic" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Asignaciones Registradas" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#6C63FF" />

            <CollectionView ItemsSource="{Binding Asignaciones}" EmptyView="No hay asignaciones registradas.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Asignacion">
                        <Frame BorderColor="#E8E8E8" BackgroundColor="#419d04ff" CornerRadius="10" Padding="14" Margin="0,4" HasShadow="False">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Alumno.Nombre, StringFormat='{0}'}" FontAttributes="Bold" FontSize="15" />
                                    <Label Text="{Binding Alumno.Apellido}" TextColor="#555" FontSize="13" />
                                    <Label Text="{Binding Curso.Nombre, StringFormat='{0}'}" TextColor="#6C63FF" FontSize="13" FontAttributes="Bold" />
                                    <Label Text="{Binding Comentarios}" TextColor="#777" FontSize="12" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding FechaAsignacion, StringFormat='{0:dd/MM/yy}'}"
                                           TextColor="#AAA" FontSize="11" HorizontalOptions="End" />
                                    <Label Text="{Binding FechaAsignacion, StringFormat='{0:HH:mm}'}"
                                           TextColor="#AAA" FontSize="11" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
