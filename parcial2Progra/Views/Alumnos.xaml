<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="parcial2Progra.Views.AlumnosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:parcial2Progra.ViewModels"
    xmlns:models="clr-namespace:parcial2Progra.Models"
    x:DataType="vm:AlumnosViewModel"
    Title="Alumnos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Registrar Alumno" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />

            <Frame BorderColor="#E0E0E0" BackgroundColor="#419d04ff" CornerRadius="12" Padding="16" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Nombre *" FontAttributes="Bold" />
                    <Entry Text="{Binding Nombre}" Placeholder="Ingresa el nombre" />

                    <Label Text="Apellido *" FontAttributes="Bold" />
                    <Entry Text="{Binding Apellido}" Placeholder="Ingresa el apellido" />

                    <Label Text="Edad" FontAttributes="Bold" />
                    <Entry Text="{Binding Edad}" Placeholder="Ingresa la edad" Keyboard="Numeric" />

                    <Label Text="Género" FontAttributes="Bold" />
                    <Entry Text="{Binding Genero}" Placeholder="Masculino / Femenino / Otro" />

                    <Label Text="Correo" FontAttributes="Bold" />
                    <Entry Text="{Binding Correo}" Placeholder="correo@ejemplo.com" Keyboard="Email" />

                    <Label Text="Teléfono" FontAttributes="Bold" />
                    <Entry Text="{Binding Telefono}" Placeholder="Ingresa el teléfono" Keyboard="Telephone" />

                    <Button Text="Guardar Alumno"
                            Command="{Binding GuardarCommand}"
                            BackgroundColor="#6C63FF"
                            TextColor="White"
                            CornerRadius="10"
                            Margin="0,8,0,0" />

                    <Label Text="{Binding Mensaje}" HorizontalOptions="Center" FontAttributes="Italic" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Alumnos Registrados" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#6C63FF" />

            <CollectionView ItemsSource="{Binding Alumnos}" EmptyView="No hay alumnos registrados.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Alumno">
                        <Frame BorderColor="#E8E8E8" BackgroundColor="#419d04ff" CornerRadius="10" Padding="14" Margin="0,4" HasShadow="False">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Nombre, StringFormat='{0}'}" FontAttributes="Bold" FontSize="15" />
                                    <Label Text="{Binding Apellido}" TextColor="#555" FontSize="14" />
                                    <Label Text="{Binding Correo, StringFormat='{0}'}" TextColor="#777" FontSize="12" />
                                    <Label Text="{Binding Telefono, StringFormat='{0}'}" TextColor="#777" FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding FechaMod, StringFormat='{0:dd/MM/yy}'}"
                                       TextColor="#AAA" FontSize="11"
                                       VerticalOptions="Start" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
