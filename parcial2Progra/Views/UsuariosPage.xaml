<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="parcial2Progra.Views.UsuariosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Usuarios">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Crear Usuario" FontSize="24" HorizontalOptions="Center" />

        <Label Text="Username" />
        <Entry x:Name="UsernameEntry" Placeholder="Ingresa el username" />

        <Label Text="Email" />
        <Entry x:Name="EmailEntry" Placeholder="Ingresa el email" Keyboard="Email" />

        <Label Text="Password" />
        <Entry x:Name="PasswordEntry" Placeholder="Ingresa el password" IsPassword="True" />

        <Button Text="Guardar Usuario" Clicked="OnGuardarClicked" />

        <Label x:Name="MensajeLabel" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
