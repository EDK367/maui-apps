<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="parcial2Progra.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:parcial2Progra.ViewModels"
    xmlns:models="clr-namespace:parcial2Progra.Models"
    x:DataType="vm:HomeViewModel"
    Title="Inicio">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">                    


            <Label Text="Bienvenido" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Panel Principal" FontSize="14" TextColor="#777" HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,4" />

            <Label Text="Últimos 10 Alumnos Registrados" FontSize="18" FontAttributes="Bold" Margin="0,6,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#6C63FF" />

            <CollectionView ItemsSource="{Binding UltimosAlumnos}" EmptyView="Aún no hay alumnos registrados.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Alumno">
                        <Frame BorderColor="#E8E8E8" CornerRadius="10" Padding="14" Margin="0,4" HasShadow="False">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Frame Grid.Column="0"
                                       WidthRequest="42" HeightRequest="42"
                                       CornerRadius="21"
                                       BackgroundColor="#6C63FF"
                                       Padding="0"
                                       HasShadow="False"
                                       VerticalOptions="Center">
                                </Frame>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="10,0,0,0" VerticalOptions="Center">
                                    <Label FontAttributes="Bold" FontSize="15">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Nombre}" />
                                                <Span Text=" " />
                                                <Span Text="{Binding Apellido}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="{Binding Correo}" TextColor="#777" FontSize="12" />
                                    <Label Text="{Binding Telefono, StringFormat='{0}'}" TextColor="#999" FontSize="12" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="{Binding FechaMod, StringFormat='{0:dd/MM/yy}'}"
                                       TextColor="#AAA" FontSize="11"
                                       VerticalOptions="Start" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
